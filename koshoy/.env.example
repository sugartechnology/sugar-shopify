# Koshoy Studio — environment variables

# Shopify Partner app (client_id = shopify.app.toml client_id)
SHOPIFY_API_KEY=7a195e853600e41bb125b39256b3da51
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products
SHOPIFY_APP_URL=https://koshoy.sugartech.io
# SHOP_CUSTOM_DOMAIN=            # optional, extra shop domain pattern

# SQLite (Docker: volume mounted at /app/data)
DATABASE_URL=file:/app/data/prod.sqlite

# LLM gateway (tagservice). SUGAR_API_BASE_URL is read as a fallback.
LLM_GATEWAY_URL=https://api.sugartech.io
# Shared secret for /api/shopify/credentials/register (afterAuth key provisioning)
SHOPIFY_SERVICE_SECRET=

# Comma list of myshopify domains with the studio enabled.
# Unset: enabled everywhere outside production, nowhere in production.
KOSHOY_SHOPS=21tn4m-us.myshopify.com

# 1 = canned chat replies (no LLM). Also mock when LLM_GATEWAY_URL is empty.
KOSHOY_CHAT_MOCK=0
# 1 = fixed price table instead of Shopify variant prices
KOSHOY_PRICE_MOCK=0
# Optional model routing passed to the gateway
KOSHOY_CHAT_PLATFORM=
KOSHOY_CHAT_MODEL=
# Number of trusted reverse proxies in front of the app (client IP for rate limits)
KOSHOY_TRUSTED_PROXY_HOPS=1
# Non-production only: use this gateway key instead of the ShopCredential row
KOSHOY_DEV_SUGAR_API_KEY=

# Cabinet core sync source (default ../../3d-room-designer/src/core/cabinet)
# CABINET_CORE_SRC=
