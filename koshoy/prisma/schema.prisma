generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// Per-shop LLM gateway key, provisioned in afterAuth.
model ShopCredential {
  shop      String   @id
  apiKey    String
  keyPrefix String
  createdAt DateTime @default(now())
}

/// Koshoy studio conversation; one per room the customer opens. Only the sha256 of the opaque browser token is stored.
model KoshoySession {
  id             String         @id
  shop           String
  tokenHash      String         @unique
  /// JSON: model session id, brief, transcript, pending tool calls
  state          String
  activeDesignId String?
  /// Latest analysed room photo (KoshoyRoom.id); written only by room-status.
  roomId         String?
  /// Signed-in Shopify customer the room belongs to (logged_in_customer_id); null = this browser only.
  customerId     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  expiresAt      DateTime
  designs        KoshoyDesign[]
  layout         KoshoyLayout?
  phoneLinks     KoshoyPhoneLink[]
  keys           KoshoySessionKey[]

  @@index([shop])
  @@index([expiresAt])
  @@index([shop, customerId])
}

/// Another device's token for the same session: a signed-in customer opened
/// an account room there (rooms.server.ts). Only the sha256 is stored.
model KoshoySessionKey {
  tokenHash String        @id
  sessionId String
  session   KoshoySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([sessionId])
}

/// One Koshoy product design (cabinet composition) inside a session.
model KoshoyDesign {
  id          String        @id
  sessionId   String
  session     KoshoySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind        String
  label       String
  version     Int           @default(1)
  /// JSON: CabinComposition
  composition String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([sessionId])
}

/// A customer's room photo and its analysis. The photo sits in Sugar S3,
/// masks and depth where the analysis wrote them. Files are never deleted,
/// so rows have no cascade: they outlive the session like the files do.
model KoshoyRoom {
  id          String    @id
  sessionId   String
  shop        String
  /// processing | ready | failed
  status      String
  /// analysis_failed | expired
  error       String?
  /// Analysis job id upstream
  jobId       String?
  /// Sugar S3 key of the photo
  photoKey    String
  /// When the customer ticked the storage consent box (POST /room consent: true)
  consentAt   DateTime?
  width       Int?
  height      Int?
  /// JSON: RoomView camera
  camera      String?
  /// JSON: RoomView planes
  planes      String?
  /// JSON: {min, max} metres
  depthScale  String?
  /// JSON: {depth, floor?, wall?, ceiling?, furniture?, objects?} links from the analysis
  fileUrls    String?
  /// Where the scale (field of view) came from: exif | user | hand_height | phone_26mm
  /// (the last two replace the 45° no-EXIF default, room-fov.ts); picks the measurement band
  scaleSource String?
  /// JSON: RoomMeasures (room-measure.server.ts), after the field-of-view correction
  measures    String?
  /// JSON: removable items of the photo, PhotoItem[] (photo-items.ts); null for analyses without objects
  objects     String?
  /// KoshoyRoomClean the customer asked for last (POST /room-clean)
  activeCleanId String?
  /// KoshoyRoomClean whose files are in use (ready); null = the original photo
  readyCleanId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cleans      KoshoyRoomClean[]

  @@index([sessionId])
}

/// Items removed from a room photo (CONTRACT §2.9, room-clean.server.ts). One row
/// per request of a selection; the files stay where decor-ai wrote them.
model KoshoyRoomClean {
  id           String     @id
  roomId       String
  room         KoshoyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sessionId    String
  shop         String
  /// JSON: selected item ids (PhotoItemView.id), sorted
  objectIds    String
  /// JSON: object map part numbers sent upstream (every part of the selected items), sorted
  parts        String
  /// processing | ready | failed
  status       String
  /// clean_failed | too_large
  error        String?
  /// Clean job id upstream
  jobId        String?
  /// Links of the cleaned photo, depth and furniture mask (decor-ai S3)
  photoUrl     String?
  depthUrl     String?
  furnitureUrl String?
  /// JSON: RoomMeasures with the cleaned furniture mask; null = the room's own
  measures     String?
  /// Upstream method and model, for our records only; never sent to the browser
  method       String?
  model        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([roomId])
}

/// One photoreal render of a design in a room. Inputs and result in Sugar S3.
model KoshoyRender {
  id           String   @id
  sessionId    String
  shop         String
  roomId       String
  /// JSON: ids of the designs drawn, left to right
  designIds    String
  /// processing | ready | failed
  status       String
  /// render_failed
  error        String?
  jobId        String?
  compositeKey String
  cabinetKey   String
  resultKey    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sessionId])
}

/// The session's room layout: which designs stand where (CONTRACT v2 §6).
/// Its own row, not KoshoySession.state: a turn saves the whole session at
/// its end and would undo drags made meanwhile.
model KoshoyLayout {
  sessionId String        @id
  /// Deleted with its session (expired sessions are pruned).
  session   KoshoySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// KoshoyRoom the places belong to; null = studio virtual wall
  roomId    String?
  /// Bumped on every write (optimistic updates)
  version   Int
  /// JSON: [{designId, place}] (room-layout LayoutItem), at most 8
  items     String
  updatedAt DateTime      @updatedAt
}

/// QR link from the desktop studio to a phone: the phone sends one room photo
/// into this session (phone-link.server.ts). Only the sha256 of the link token
/// is stored; the token itself is in the QR only.
model KoshoyPhoneLink {
  id        String        @id
  sessionId String
  session   KoshoySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  shop      String
  tokenHash String        @unique
  expiresAt DateTime
  /// Set when the phone starts sending; the link takes no other photo.
  usedAt    DateTime?
  /// KoshoyRoom the phone's photo became
  roomId    String?
  createdAt DateTime      @default(now())

  @@index([sessionId])
  @@index([expiresAt])
}

/// Journey data the store team edits through the data API (data.server.ts):
/// rooms | kinds | levels | scope | texts | images. One row per document.
model KoshoyDataDoc {
  key       String   @id
  /// Bumped on every save
  version   Int
  /// JSON: the validated document
  json      String
  updatedAt DateTime @updatedAt
}

/// Every saved version of a data document, kept for looking back.
model KoshoyDataHistory {
  id        String   @id
  key       String
  version   Int
  json      String
  createdAt DateTime @default(now())

  @@index([key])
}

/// One journey step a customer reached (journey-events.server.ts). No relation to
/// KoshoySession: events outlive sessions and are pruned after 180 days.
model KoshoyEvent {
  id        String   @id
  at        DateTime @default(now())
  sessionId String
  /// KOSHOY_JOURNEY_EVENTS name
  name      String
  /// phone | desktop
  device    String
  /// JSON: small flat props, never personal data
  props     String?

  @@index([at])
  @@index([name])
}
