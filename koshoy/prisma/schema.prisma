generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// Per-shop LLM gateway key, provisioned in afterAuth.
model ShopCredential {
  shop      String   @id
  apiKey    String
  keyPrefix String
  createdAt DateTime @default(now())
}

/// Koshoy studio conversation. Only the sha256 of the opaque browser token is stored.
model KoshoySession {
  id             String         @id
  shop           String
  tokenHash      String         @unique
  /// JSON: model session id, brief, transcript, pending tool calls
  state          String
  activeDesignId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  expiresAt      DateTime
  designs        KoshoyDesign[]

  @@index([shop])
  @@index([expiresAt])
}

/// One Koshoy product design (cabinet composition) inside a session.
model KoshoyDesign {
  id          String        @id
  sessionId   String
  session     KoshoySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind        String
  label       String
  version     Int           @default(1)
  /// JSON: CabinComposition
  composition String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([sessionId])
}
