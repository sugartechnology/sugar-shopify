{% comment %}
  Shared Sugar Curator markup.
  {% render 'room-studio-root', settings: block.settings, sugar_attributes: block.shopify_attributes %}
{% endcomment %}

{{ 'room-studio.css' | asset_url | stylesheet_tag }}
<script src="{{ 'room-studio.js' | asset_url }}" defer></script>

{%- liquid
  assign display_mode = settings.display_mode | default: 'modal'
  if display_mode != 'embedded'
    assign display_mode = 'modal'
  endif

  assign shop_locale = request.locale.iso_code | default: localization.language.iso_code | default: 'tr'
  assign shop_currency = cart.currency.iso_code | default: shop.currency
  assign mf = shop.metafields.sugar_shopify

  assign button_label = settings.button_label
  if button_label == blank
    assign button_label = 'sugar_rs.button_label' | t
  endif
  assign button_helper = settings.button_helper
  if button_helper == blank
    assign button_helper = 'sugar_rs.button_helper' | t
  endif
  assign modal_title = settings.modal_title
  if modal_title == blank
    assign modal_title = 'sugar_rs.modal_title' | t
  endif
  assign modal_subtitle = settings.modal_subtitle
  if modal_subtitle == blank
    assign modal_subtitle = 'sugar_rs.modal_subtitle' | t
  endif
  assign add_cart_label = settings.add_cart_label
  if add_cart_label == blank
    assign add_cart_label = 'sugar_rs.add_cart_label' | t
  endif

  assign max_products = settings.max_products | default: 5
  assign max_design_attempts = settings.max_design_attempts | default: 3
  assign max_upload_mb = mf.max_upload_size_mb | default: '10'
  assign image_property_key = mf.image_property_key | default: '_sugar_design_image'
  assign generation_id_key = mf.generation_id_property_key | default: '_sugar_generation_id'
  assign custom_css = mf.custom_css

  assign product_detail_metafields_default = '[{"namespace":"custom","key":"material","label":"Malzeme"},{"namespace":"custom","key":"dimensions","label":"Ölçü"},{"namespace":"custom","key":"color","label":"Renk"}]'
  assign product_detail_metafields_json = settings.product_detail_metafields | default: product_detail_metafields_default
  assign product_detail_metafield_namespace = settings.product_detail_metafield_namespace | default: 'custom'

  assign theme_preset = settings.theme_preset | default: 'dawn'
  assign modal_bg_color = settings.modal_bg_color | default: '#ffffff'
  assign modal_text_color = settings.modal_text_color | default: '#121212'
  assign accent_color = settings.accent_color | default: '#c4a574'
  assign overlay_color = 'rgba(0, 0, 0, 0.55)'
  if settings.overlay_color != blank and settings.overlay_color != '#000000'
    assign overlay_color = settings.overlay_color
  endif
  assign modal_radius = settings.modal_radius | default: 16
  assign font_scale_pct = settings.font_scale | default: 100

  assign ai_btn_classes = settings.ai_button_classes | default: 'sugar-rs-trigger-btn'
  assign primary_classes = settings.primary_button_classes | default: 'button button--primary'
  assign secondary_classes = settings.secondary_button_classes | default: 'button button--secondary'

  assign header_icon_url = ''
  if settings.header_icon != blank
    assign header_icon_url = settings.header_icon | image_url: width: 64
  endif

  assign catalog_collections = settings.catalog_collections
  assign use_all_products = false
  if settings.use_all_products == true or settings.use_all_products == 'true'
    assign use_all_products = true
  endif
-%}

{%- capture catalog_handles_json -%}
[
  {%- if use_all_products -%}
    "all"
    {%- assign handle_first = false -%}
  {%- else -%}
    {%- assign handle_first = true -%}
  {%- endif -%}
  {%- if catalog_collections != blank -%}
    {%- for coll in catalog_collections -%}
      {%- if coll != blank and coll.handle != blank and coll.handle != 'all' -%}
        {%- unless handle_first -%},{%- endunless -%}
        {{ coll.handle | json }}
        {%- assign handle_first = false -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
]
{%- endcapture -%}

{%- capture catalog_json -%}
{
  "categories": [
    {
      "id": "all",
      "title": {{ 'sugar_rs.all_products' | t | json }},
      "count": 0,
      "productIds": []
    }
    {%- if catalog_collections != blank -%}
      {%- for coll in catalog_collections -%}
        {%- if coll != blank -%}
          ,{
            "id": {{ coll.handle | json }},
            "title": {{ coll.title | json }},
            "count": {{ coll.products_count | default: coll.products.size | json }},
            "productIds": [
              {%- for cat_product in coll.products limit: 50 -%}
                {%- unless forloop.first -%},{%- endunless -%}
                {{ cat_product.id | json }}
              {%- endfor -%}
            ]
          }
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  ],
  "products": [
    {%- assign first_product = true -%}
    {%- assign emitted_ids = ',' -%}
    {%- if use_all_products and collections.all -%}
      {%- for cat_product in collections.all.products limit: 50 -%}
        {%- assign id_token = cat_product.id | prepend: ',' | append: ',' -%}
        {%- unless emitted_ids contains id_token -%}
          {%- assign emitted_ids = emitted_ids | append: cat_product.id | append: ',' -%}
          {%- assign cat_variant = cat_product.selected_or_first_available_variant -%}
          {%- assign cat_img = cat_variant.featured_media | default: cat_product.featured_media -%}
          {%- unless first_product -%},{%- endunless -%}
          {%- assign first_product = false -%}
          {
            "productId": {{ cat_product.id | json }},
            "variantId": {{ cat_variant.id | json }},
            "title": {{ cat_product.title | json }},
            "handle": {{ cat_product.handle | json }},
            "price": {{ cat_variant.price | json }},
            "currency": {{ shop_currency | json }},
            "imageUrl": {% if cat_img != blank %}{{ cat_img | image_url: width: 600 | json }}{% else %}""{% endif %},
            "images": [
              {%- assign img_count = 0 -%}
              {%- for media in cat_product.media -%}
                {%- if img_count >= 3 -%}{%- break -%}{%- endif -%}
                {%- if media.media_type == 'image' -%}
                  {%- if img_count > 0 -%},{%- endif -%}
                  {{ media | image_url: width: 800 | json }}
                  {%- assign img_count = img_count | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            ],
            "categoryIds": []
          }
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if catalog_collections != blank -%}
      {%- for coll in catalog_collections -%}
        {%- if coll != blank -%}
          {%- for cat_product in coll.products limit: 50 -%}
            {%- assign id_token = cat_product.id | prepend: ',' | append: ',' -%}
            {%- unless emitted_ids contains id_token -%}
              {%- assign emitted_ids = emitted_ids | append: cat_product.id | append: ',' -%}
              {%- assign cat_variant = cat_product.selected_or_first_available_variant -%}
              {%- assign cat_img = cat_variant.featured_media | default: cat_product.featured_media -%}
              {%- unless first_product -%},{%- endunless -%}
              {%- assign first_product = false -%}
              {
                "productId": {{ cat_product.id | json }},
                "variantId": {{ cat_variant.id | json }},
                "title": {{ cat_product.title | json }},
                "handle": {{ cat_product.handle | json }},
                "price": {{ cat_variant.price | json }},
                "currency": {{ shop_currency | json }},
                "imageUrl": {% if cat_img != blank %}{{ cat_img | image_url: width: 600 | json }}{% else %}""{% endif %},
                "images": [
                  {%- assign img_count = 0 -%}
                  {%- for media in cat_product.media -%}
                    {%- if img_count >= 3 -%}{%- break -%}{%- endif -%}
                    {%- if media.media_type == 'image' -%}
                      {%- if img_count > 0 -%},{%- endif -%}
                      {{ media | image_url: width: 800 | json }}
                      {%- assign img_count = img_count | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                ],
                "categoryIds": [{{ coll.handle | json }}]
              }
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  ]
}
{%- endcapture -%}

{%- capture sugar_rs_css_vars -%}
--sugar-rs-accent: {{ accent_color }};
--sugar-rs-text: {{ modal_text_color }};
--sugar-rs-bg: {{ modal_bg_color }};
--sugar-rs-overlay: {{ overlay_color }};
--sugar-rs-radius: {{ modal_radius }}px;
--sugar-rs-font-scale: {{ font_scale_pct | times: 0.01 }};
{%- endcapture -%}

<div
  class="sugar-rs-root sugar-rs-root--{{ display_mode }}{% if embed_mode %} sugar-rs-root--embed{% endif %}"
  data-sugar-rs-root
  data-display-mode="{{ display_mode }}"
  data-sugar-rs-theme="{{ theme_preset }}"
  style="{{ sugar_rs_css_vars | strip }}"
  {{ sugar_attributes }}
  data-sugar-rs-config='{
    "proxyUrl": "/apps/sugar/generate",
    "displayMode": {{ display_mode | json }},
    "imagePropertyKey": {{ image_property_key | json }},
    "generationIdPropertyKey": {{ generation_id_key | json }},
    "maxUploadSizeMb": {{ max_upload_mb | json }},
    "maxProducts": {{ max_products | json }},
    "maxDesignAttempts": {{ max_design_attempts | json }},
    "customCss": {{ custom_css | json }},
    "modalTitle": {{ modal_title | json }},
    "modalSubtitle": {{ modal_subtitle | json }},
    "addDesignToCartLabel": {{ add_cart_label | json }},
    "primaryButtonClasses": {{ primary_classes | json }},
    "secondaryButtonClasses": {{ secondary_classes | json }},
    "shopDomain": {{ shop.permanent_domain | json }},
    "useAllProducts": {% if use_all_products %}true{% else %}false{% endif %},
    "catalogHandles": {{ catalog_handles_json | strip_newlines }},
    "currency": {{ shop_currency | json }},
    "productDetailMetafieldsJson": {{ product_detail_metafields_json | json }},
    "productDetailMetafieldNamespace": {{ product_detail_metafield_namespace | json }},
    "locale": {{ shop_locale | json }},
    "headerIconUrl": {{ header_icon_url | json }},
    "i18n": {
      "closeAria": {{ 'sugar_rs.close_aria' | t | json }},
      "stepProducts": {{ 'sugar_rs.step_products' | t | json }},
      "stepProductsHint": {{ 'sugar_rs.step_products_hint' | t | json }},
      "stepUpload": {{ 'sugar_rs.step_upload' | t | json }},
      "stepUploadHint": {{ 'sugar_rs.step_upload_hint' | t | json }},
      "stepResult": {{ 'sugar_rs.step_result' | t | json }},
      "stepResultHint": {{ 'sugar_rs.step_result_hint' | t | json }},
      "searchCategories": {{ 'sugar_rs.search_categories' | t | json }},
      "searchProducts": {{ 'sugar_rs.search_products' | t | json }},
      "allProducts": {{ 'sugar_rs.all_products' | t | json }},
      "selectedCount": {{ 'sugar_rs.selected_count' | t | json }},
      "selectedProducts": {{ 'sugar_rs.selected_products' | t | json }},
      "selectedHint": {{ 'sugar_rs.selected_hint' | t | json }},
      "yourRoom": {{ 'sugar_rs.your_room' | t | json }},
      "changePhoto": {{ 'sugar_rs.change_photo' | t | json }},
      "removePhoto": {{ 'sugar_rs.remove_photo' | t | json }},
      "uploadRoom": {{ 'sugar_rs.upload_room' | t | json }},
      "uploadRoomHint": {{ 'sugar_rs.upload_room_hint' | t | json }},
      "tipsLabel": {{ 'sugar_rs.tips_label' | t | json }},
      "tipsText": {{ 'sugar_rs.tips_text' | t | json }},
      "clearAll": {{ 'sugar_rs.clear_all' | t | json }},
      "seeMySpace": {{ 'sugar_rs.see_my_space' | t | json }},
      "loadingTitle": {{ 'sugar_rs.loading_title' | t | json }},
      "loadingSubtitle": {{ 'sugar_rs.loading_subtitle' | t | json }},
      "loadingProgress": {{ 'sugar_rs.loading_progress' | t | json }},
      "resultReady": {{ 'sugar_rs.result_ready' | t | json }},
      "addCartLabel": {{ add_cart_label | json }},
      "backToStudio": {{ 'sugar_rs.back_to_studio' | t | json }},
      "redesign": {{ 'sugar_rs.redesign' | t | json }},
      "compareOrigin": {{ 'sugar_rs.compare_origin' | t | json }},
      "compareDesign": {{ 'sugar_rs.compare_design' | t | json }},
      "errorUpload": {{ 'sugar_rs.error_upload' | t | json }},
      "errorSize": {{ 'sugar_rs.error_size' | t | json }},
      "errorRoomRequired": {{ 'sugar_rs.error_room_required' | t | json }},
      "errorSelectProduct": {{ 'sugar_rs.error_select_product' | t | json }},
      "errorGenerate": {{ 'sugar_rs.error_generate' | t | json }},
      "errorGenerateProxy": {{ 'sugar_rs.error_generate_proxy' | t | json }},
      "errorGenerateStorePassword": {{ 'sugar_rs.error_generate_store_password' | t | json }},
      "errorGeneric": {{ 'sugar_rs.error_generic' | t | json }},
      "errorCart": {{ 'sugar_rs.error_cart' | t | json }},
      "errorCartRetry": {{ 'sugar_rs.error_cart_retry' | t | json }},
      "errorMaxProducts": {{ 'sugar_rs.error_max_products' | t | json }},
      "errorNoCatalog": {{ 'sugar_rs.error_no_catalog' | t | json }},
      "cartSuccess": {{ 'sugar_rs.cart_success' | t | json }},
      "cartSuccessDetail": {{ 'sugar_rs.cart_success_detail' | t | json }},
      "emptyCategory": {{ 'sugar_rs.empty_category' | t | json }},
      "addProduct": {{ 'sugar_rs.add_product' | t | json }},
      "removeProduct": {{ 'sugar_rs.remove_product' | t | json }}
    }
  }'
  data-sugar-rs-catalog='{{ catalog_json | strip_newlines }}'
>
  {%- if display_mode == 'modal' -%}
    <div class="sugar-rs-trigger-wrap">
      <button type="button" class="{{ ai_btn_classes }}" data-sugar-rs-open>
        <span class="sugar-rs-trigger-btn__icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z"/><path d="M19 14l.75 2.25L22 17l-2.25.75L19 20l-.75-2.25L16 17l2.25-.75L19 14z"/></svg>
        </span>
        <span data-sugar-rs-trigger-label>{{ button_label }}</span>
      </button>
      {%- if button_helper != blank -%}
        <p class="sugar-rs-trigger-helper">{{ button_helper }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if display_mode == 'modal' -%}
  <dialog class="sugar-rs-dialog" data-sugar-rs-dialog>
  {%- else -%}
  <div class="sugar-rs-embedded-shell" data-sugar-rs-shell>
  {%- endif -%}

    <div class="sugar-rs-panel">
      <header class="sugar-rs-header">
        <div class="sugar-rs-header__brand">
          {%- if header_icon_url != blank -%}
            <img class="sugar-rs-header__icon" src="{{ header_icon_url }}" alt="" width="28" height="28">
          {%- else -%}
            <span class="sugar-rs-header__icon-fallback" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            </span>
          {%- endif -%}
          <div>
            <h2 class="sugar-rs-header__title" data-sugar-rs-title>{{ modal_title }}</h2>
            <p class="sugar-rs-header__subtitle" data-sugar-rs-subtitle>{{ modal_subtitle }}</p>
          </div>
        </div>

        <nav class="sugar-rs-stepper" data-sugar-rs-stepper aria-label="Steps">
          <div class="sugar-rs-stepper__item is-active" data-sugar-rs-step-indicator="studio">
            <span class="sugar-rs-stepper__num">1</span>
            <span class="sugar-rs-stepper__text">
              <strong>{{ 'sugar_rs.step_products' | t }}</strong>
              <small>{{ 'sugar_rs.step_products_hint' | t }}</small>
            </span>
          </div>
          <div class="sugar-rs-stepper__item" data-sugar-rs-step-indicator="upload">
            <span class="sugar-rs-stepper__num">2</span>
            <span class="sugar-rs-stepper__text">
              <strong>{{ 'sugar_rs.step_upload' | t }}</strong>
              <small>{{ 'sugar_rs.step_upload_hint' | t }}</small>
            </span>
          </div>
          <div class="sugar-rs-stepper__item" data-sugar-rs-step-indicator="result">
            <span class="sugar-rs-stepper__num">3</span>
            <span class="sugar-rs-stepper__text">
              <strong>{{ 'sugar_rs.step_result' | t }}</strong>
              <small>{{ 'sugar_rs.step_result_hint' | t }}</small>
            </span>
          </div>
        </nav>

        {%- if display_mode == 'modal' -%}
          <button type="button" class="sugar-rs-close" data-sugar-rs-close aria-label="{{ 'sugar_rs.close_aria' | t }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        {%- endif -%}
      </header>

      <div class="sugar-rs-toast" data-sugar-rs-toast hidden role="status"></div>

      <div class="sugar-rs-step is-active" data-sugar-rs-step="studio">
        <div class="sugar-rs-studio">
          <aside class="sugar-rs-cats">
            <label class="sugar-rs-search">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
              <input type="search" data-sugar-rs-cat-search placeholder="{{ 'sugar_rs.search_categories' | t }}" autocomplete="off">
            </label>
            <ul class="sugar-rs-cat-list" data-sugar-rs-cat-list role="listbox"></ul>
          </aside>

          <section class="sugar-rs-browse">
            <div class="sugar-rs-browse__head">
              <h3 class="sugar-rs-browse__title" data-sugar-rs-browse-title>{{ 'sugar_rs.all_products' | t }}</h3>
              <p class="sugar-rs-browse__count" data-sugar-rs-selected-count></p>
            </div>
            <label class="sugar-rs-search sugar-rs-search--products">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
              <input type="search" data-sugar-rs-product-search placeholder="{{ 'sugar_rs.search_products' | t }}" autocomplete="off">
            </label>
            <div class="sugar-rs-grid" data-sugar-rs-grid></div>
            <p class="sugar-rs-empty" data-sugar-rs-empty hidden>{{ 'sugar_rs.empty_category' | t }}</p>
          </section>

          <aside class="sugar-rs-side">
            <div class="sugar-rs-room">
              <div class="sugar-rs-room__head">
                <h3>{{ 'sugar_rs.your_room' | t }}</h3>
                <div class="sugar-rs-room__actions" data-sugar-rs-room-actions hidden>
                  <button type="button" class="sugar-rs-link-btn" data-sugar-rs-change-room>{{ 'sugar_rs.change_photo' | t }}</button>
                  <button type="button" class="sugar-rs-icon-btn" data-sugar-rs-remove-room aria-label="{{ 'sugar_rs.remove_photo' | t }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
                  </button>
                </div>
              </div>
              <div class="sugar-rs-room__preview" data-sugar-rs-room-preview>
                <img data-sugar-rs-room-img alt="" hidden>
                <button type="button" class="sugar-rs-room__upload" data-sugar-rs-room-upload-btn>
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10.5" r="1.5"/><path d="M21 16l-5-5-7 7"/></svg>
                  <span>{{ 'sugar_rs.upload_room' | t }}</span>
                  <small>{{ 'sugar_rs.upload_room_hint' | t }}</small>
                </button>
              </div>
              <input type="file" accept="image/*" data-sugar-rs-room-file hidden>
            </div>

            <div class="sugar-rs-slots">
              <h3 data-sugar-rs-slots-title></h3>
              <p class="sugar-rs-slots__hint" data-sugar-rs-slots-hint></p>
              <div class="sugar-rs-slots__row" data-sugar-rs-slots></div>
            </div>
          </aside>
        </div>

        <footer class="sugar-rs-footer">
          <div class="sugar-rs-tips">
            <span class="sugar-rs-tips__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 18h6M10 21h4M12 3a6 6 0 00-3 11v2h6v-2a6 6 0 00-3-11z"/></svg>
            </span>
            <div>
              <strong>{{ 'sugar_rs.tips_label' | t }}</strong>
              <p>{{ 'sugar_rs.tips_text' | t }}</p>
            </div>
          </div>
          <div class="sugar-rs-footer__actions">
            <button type="button" class="sugar-rs-ghost-btn" data-sugar-rs-clear>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12"/></svg>
              {{ 'sugar_rs.clear_all' | t }}
            </button>
            <button type="button" class="sugar-rs-primary-btn" data-sugar-rs-generate>
              {{ 'sugar_rs.see_my_space' | t }}
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </footer>
      </div>

      <div class="sugar-rs-step" data-sugar-rs-step="upload">
        <div class="sugar-rs-upload-focus">
          <h3>{{ 'sugar_rs.step_upload' | t }}</h3>
          <p>{{ 'sugar_rs.step_upload_hint' | t }}</p>
          <button type="button" class="sugar-rs-primary-btn" data-sugar-rs-upload-focus-btn>
            {{ 'sugar_rs.upload_room' | t }}
          </button>
          <button type="button" class="sugar-rs-ghost-btn" data-sugar-rs-back-studio>
            {{ 'sugar_rs.back_to_studio' | t }}
          </button>
        </div>
      </div>

      <div class="sugar-rs-step" data-sugar-rs-step="loading">
        <div class="sugar-rs-loading">
          <div class="sugar-rs-loading__spinner" aria-hidden="true"></div>
          <h3>{{ 'sugar_rs.loading_title' | t }}</h3>
          <p>{{ 'sugar_rs.loading_subtitle' | t }}</p>
          <div class="sugar-rs-loading__bar"><span data-sugar-rs-loading-bar></span></div>
          <p class="sugar-rs-loading__pct" data-sugar-rs-loading-pct></p>
        </div>
      </div>

      <div class="sugar-rs-step" data-sugar-rs-step="result">
        <div class="sugar-rs-result">
          <div class="sugar-rs-result__head">
            <p class="sugar-rs-result__badge">{{ 'sugar_rs.result_ready' | t }}</p>
            <button type="button" class="sugar-rs-ghost-btn" data-sugar-rs-back-studio-result>
              {{ 'sugar_rs.back_to_studio' | t }}
            </button>
          </div>
          <div class="sugar-rs-compare" data-sugar-rs-compare>
            <img data-sugar-rs-compare-origin alt="{{ 'sugar_rs.compare_origin' | t }}">
            <img data-sugar-rs-compare-design alt="{{ 'sugar_rs.compare_design' | t }}">
            <input type="range" min="0" max="100" value="50" data-sugar-rs-compare-range aria-label="Compare">
          </div>
          <ul class="sugar-rs-result-list" data-sugar-rs-result-list></ul>
          <div class="sugar-rs-result__actions">
            <button type="button" class="sugar-rs-ghost-btn" data-sugar-rs-redesign>{{ 'sugar_rs.redesign' | t }}</button>
            <button type="button" class="sugar-rs-primary-btn {{ primary_classes }}" data-sugar-rs-add-cart>{{ add_cart_label }}</button>
          </div>
        </div>
      </div>
    </div>

  {%- if display_mode == 'modal' -%}
  </dialog>
  {%- else -%}
  </div>
  {%- endif -%}
</div>
